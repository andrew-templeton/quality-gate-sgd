{
  "name": "quality-gate-sgd",
  "version": "2.0.0-dev.2",
  "description": "Domain-independent quality assertions, calibrated comparisons, and budgeted improvement loops",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "quality-gate-v2": "./dist/v2/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc",
    "test": "vitest run && node --test tests/work-graph.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "prepublishOnly": "npm run build",
    "test:v2": "vitest run tests/v2",
    "plan:generate": "node scripts/work-graph.mjs write",
    "plan:check": "node scripts/work-graph.mjs check",
    "check:package": "node scripts/check-package.mjs",
    "check:types": "tsc --noEmit --strict --skipLibCheck --module NodeNext --target ES2022 tests/public-contract-types.ts"
  },
  "keywords": [
    "quality",
    "gate",
    "llm",
    "ai",
    "sgd",
    "gradient-descent",
    "testing",
    "assertions",
    "evaluation",
    "calibration",
    "legibility"
  ],
  "author": "Andrew Templeton",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrew-templeton/quality-gate-sgd.git"
  },
  "homepage": "https://github.com/andrew-templeton/quality-gate-sgd#readme",
  "bugs": {
    "url": "https://github.com/andrew-templeton/quality-gate-sgd/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/v2",
    "docs/work",
    "examples/v2"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "tsx": "^4.0.0",
    "vitest": "^4.0.17",
    "typescript": "^5.0.0"
  }
}
