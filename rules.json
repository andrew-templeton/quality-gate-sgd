{
  "version": "1.0.0",
  "description": "Quality gates for quality-sgd - 90% coverage requirement",
  "rules": {
    "floors": {
      "coverage.unit.branches": 90,
      "coverage.unit.statements": 90
    },
    "ceilings": {
      "typescript.errors": 0,
      "eslint.errors": 0
    },
    "monotonic": [
      {
        "direction": "up",
        "metrics": [
          "coverage.unit.branches",
          "coverage.unit.statements"
        ]
      },
      {
        "direction": "down",
        "metrics": [
          "typescript.errors"
        ]
      },
      {
        "direction": "down",
        "metrics": [
          "eslint.errors"
        ]
      }
    ],
    "requiredScripts": [
      "test"
    ]
  }
}
